datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ProjectOverview {
  id          Int       @id @default(autoincrement())
  title       String
  images      String[]
  description String?
  startDate   DateTime?
  endDate     DateTime?
  githubLink  String?
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   Int       @unique
}

model Project {
  id          Int              @id @default(autoincrement())
  title       String
  image       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  githubLink  String?
  overview    ProjectOverview?
}

