generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProjectOverview {
  id          Int       @id @default(autoincrement())
  projectId   Int       @unique
  title       String
  description String?
  endDate     DateTime?
  githubLink  String?
  startDate   DateTime?
  images      String[]
  project     Project   @relation(fields: [projectId], references: [id])
}

model Project {
  id          Int              @id @default(autoincrement())
  description String?
  endDate     DateTime?
  githubLink  String?
  startDate   DateTime?
  title       String
  image       String
  overview    ProjectOverview?
}
